rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin Helper Function
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'zaidenyuri26@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Services Collection (Services Catalog)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Builds Collection (Project Car Chronicles)
    match /builds/{buildId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Meta Collection (System & Connection Check)
    match /_meta/{docId} {
      allow read, write: if true;
    }

    // Orders Collection (Anti-Payment Fraud Security Rules)
    match /orders/{orderId} {
      allow read: if true;
      
      // Customers can only create orders with 'pending_verification' or 'unpaid' status
      allow create: if request.resource.data.paymentStatus in ['pending_verification', 'unpaid']
                   && request.resource.data.status == 'pending';

      // Customers CANNOT modify paymentStatus to 'verified' or 'paid' or change order status
      allow update: if isAdmin();

      // Only Admins can delete order documents
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Site Settings Collection
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
